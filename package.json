{
  "name": "emos-music-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "test:visual": "node e2e/visual.mjs",
    "test:visual:update": "node e2e/visual.mjs --update",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "format": "prettier --write src vite.config.ts",
    "format:check": "prettier --check src vite.config.ts",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@applemusic-like-lyrics/lyric": "^1.1.0",
    "@vueuse/core": "^14.4.0",
    "browser-image-compression": "^2.0.2",
    "dayjs": "^1.11.21",
    "hash-wasm": "^4.12.0",
    "ky": "^1.14.0",
    "music-metadata": "^11.10.3",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.1.17",
    "tus-js-client": "^4.3.1",
    "vue": "^3.5.34",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "pixelmatch": "8.0.0",
    "playwright": "1.65.1",
    "pngjs": "7.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.0.12",
    "vitest": "^5.1.1",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.2.8"
  },
  "packageManager": "pnpm@12.4.2"
}
