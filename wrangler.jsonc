/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emos-music-web",
  "compatibility_date": "2026-11-14",
  "assets": {
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "directory": "./dist/",
  },
  "observability": {
    "logs": {
      "enabled": false,
    },
    "traces": {
      "enabled": false,
    },
  },
  // 只接管静态资源与入口，其余路径留给同域的 Caddy 网关（/api、/rest、/navidrome、/upload…）。
  // 注意：不能用 "music.emos.best/*" —— 那样会把 /api/* 也交给静态资源处理，
  // 请求会命中 SPA 回退返回 index.html，前端拿到的就不是 JSON 了。
  "routes": [
    {
      "pattern": "music.emos.best/",
      "zone_name": "emos.best",
    },
    {
      "pattern": "music.emos.best/favicon*",
      "zone_name": "emos.best",
    },
    {
      "pattern": "music.emos.best/robots.txt",
      "zone_name": "emos.best",
    },
    {
      "pattern": "music.emos.best/assets/*",
      "zone_name": "emos.best",
    },
    {
      "pattern": "music.emos.best/.well-known/*",
      "zone_name": "emos.best",
    },
  ],
}
