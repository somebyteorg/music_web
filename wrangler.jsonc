/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emos-music-web",
  "compatibility_date": "2026-11-14",
  "assets": {
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "directory": "./dist/",
  },
  "observability": {
    "logs": {
      "enabled": false,
    },
    "traces": {
      "enabled": false,
    },
  },
  // 全域通配：之前的逐条白名单会让「/?a=b」「/settings」直接 404，
  // 还会让「/assets/不存在的文件」落到 SPA 回退返回 HTML（旧页面拿旧 chunk 时白屏）
  "routes": [
    {
      "pattern": "music.emos.best/*",
      "zone_name": "emos.best",
    },
  ],
}
